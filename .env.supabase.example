# Activate the Supabase-specific Spring profile.
SPRING_PROFILES_ACTIVE=supabase

# Copy the exact Session pooler values from Supabase Dashboard > Connect.
SUPABASE_DB_URL=jdbc:postgresql://POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=replace-with-your-database-password

# Optional Hikari pool tuning.
SUPABASE_DB_POOL_SIZE=5
SUPABASE_DB_MIN_IDLE=0
SUPABASE_DB_CONNECTION_TIMEOUT_MS=30000

# Set this same random 32+ character value in Render and Vercel.
APP_COOKIE_SECURE=true
TASKFLOW_PROXY_SECRET=replace-with-a-random-32-character-secret
APP_MAX_TASKS_PER_USER=2000
